# Copy to `.env` and fill in. Real environment variables always win
# over this file. NEVER commit `.env` (it holds the tunnel token).

# --- server ---
OPENHOME_PORT=8080
OPENHOME_DB=openhome.db
# Pepper appended to the password hash. Set a random value when the server
# is reachable beyond localhost.
OPENHOME_PEPPER=

# --- public exposure (Cloudflare Tunnel, dashboard-managed) ---
# Public hostname (informational: printed at startup).
OPENHOME_HOSTNAME=home.himanshu.pro
# auto (default): start tunnel when a token is present.
# off: LAN-only even if a token is set.
# OPENHOME_TUNNEL=auto
# Tunnel token: Zero Trust -> Networks -> Tunnels -> <tunnel> -> Configure
# -> copy the `cloudflared ... run --token <TOKEN>` token. Dashboard owns
# the home.himanshu.pro ingress + DNS, so nothing else is configured here.
OPENHOME_TUNNEL_TOKEN=
# Path to cloudflared when it is not on PATH.
# CLOUDFLARED_BIN=/opt/homebrew/bin/cloudflared
